<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SimpleFarming</AssemblyName>
    <RootNamespace>SimpleFarming</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\Assemblies</OutputPath>
    <!-- Mods ship as Release builds only: Debug JIT output is slower and larger. Explicit
         -c Debug is still possible for IDE debugging, but bare `dotnet build` = Release. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- RimWorld loads plain mod assemblies; no deps.json needed next to the dll. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Override with -p:RimWorldDir="C:\path\to\RimWorld" if your install lives elsewhere. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <GameManaged>$(RimWorldDir)\RimWorldWin64_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Players load the Workshop Harmony mod (declared in About.xml); Lib.Harmony is
         compile-time only - ExcludeAssets=runtime keeps the dll out of Assemblies. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
